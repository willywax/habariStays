# Backend Environment Variables Template for GCP
# Copy this to .env and fill in your values

# MongoDB Connection (Required)
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=habari_stays

# JWT Configuration (Required)
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# Google OAuth (Required for Google Sign-In)
GOOGLE_CLIENT_ID=your-google-oauth-client-id-here

# Cloudinary Configuration (Optional - for photo uploads)
CLOUDINARY_CLOUD_NAME=diupey6vs
CLOUDINARY_UPLOAD_PRESET=habari_stays_upload

# Beem SMS Configuration (Optional - for SMS notifications)
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SENDER_ID=HABARISTAYS

# Payment Configuration (Optional)
SELCOM_TILL_NUMBER=123456

# Server Configuration
PORT=8080
