# Habari Stays Backend Environment Variables

# ====================
# DATABASE CONFIGURATION
# ====================

# PostgreSQL (primary database)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/habari_stays"

# MongoDB (legacy - only needed for data migration)
# MONGO_URL="mongodb://localhost:27017"
# DB_NAME="habari_stays"

# ====================
# SECURITY
# ====================

# JWT secret key - CHANGE IN PRODUCTION!
SECRET_KEY="your-super-secret-key-change-in-production"

# CORS allowed origins (comma-separated or * for all)
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"

# ====================
# EXTERNAL SERVICES
# ====================

# Beem SMS API (Tanzania)
BEEM_API_KEY="your-beem-api-key"
BEEM_SECRET_KEY="your-beem-secret-key"
BEEM_SENDER_ID="YOUR_SENDER"

# Selcom Payment Gateway
SELCOM_TILL_NUMBER="your-till-number"

# Cloudinary (Image Storage)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_UPLOAD_PRESET="your-upload-preset"

# ====================
# OPTIONAL SETTINGS
# ====================

# Server port (default: 8000)
# PORT=8000

# Enable debug mode (default: false)
# DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
